# Copy this file to .env for local development. Never commit real values.
# Production values belong in Vercel Project Settings → Environment Variables.

# Hosted PostgreSQL connection string. Use localhost only for local development.
DATABASE_URL=""

# Generate a unique value with: openssl rand -hex 32
ATTENDX_SECRET=""

# Google Cloud OAuth Web Application credentials. Server-side only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local: http://localhost:3000/api/auth/google/callback
# Production: https://<your-site>.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=""

# Optional canonical public application URL. Leave blank locally.
NEXT_PUBLIC_APP_URL=""

# Web3Forms access key for the server-side Contact Us endpoint.
WEB3FORMS_ACCESS_KEY=""

# Gmail SMTP for OTP emails (use Gmail App Password, not your regular password)
# Get an App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FROM="AttendX <your-email@gmail.com>"

# Optional: Upstash Redis for production-grade rate limiting
# Leave blank to use PostgreSQL fallback (already configured)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
