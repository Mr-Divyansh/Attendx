# Copy this file to .env for local development. Never commit real values.
# Production values belong in Vercel Project Settings → Environment Variables.

# Hosted PostgreSQL connection string. Use localhost only for local development.
DATABASE_URL=""

# Generate a unique value with: openssl rand -hex 32
ATTENDX_SECRET=""

# Initial Master Admin bootstrap. Both values are server-only.
# Set to the existing account email and a random secret of at least 32 characters.
# Remove or rotate the bootstrap secret after the account is promoted.
ATTENDX_SUPER_ADMIN_EMAIL=""
ATTENDX_SUPER_ADMIN_BOOTSTRAP_SECRET=""

# Google Cloud OAuth Web Application credentials. Server-side only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local: http://localhost:3000/api/auth/google/callback
# Production: https://<your-site>.vercel.app/api/auth/google/callback
# On Vercel Preview, AttendX uses the validated current Preview hostname for
# both OAuth callback and return URL. Register that callback URI in Google
# Cloud and access Preview through its Vercel branch alias.
GOOGLE_CALLBACK_URL=""

# Canonical public application URL used in password-reset and security emails.
# Production must use the exact trusted HTTPS deployment URL; never derive it
# from an incoming Host header. For production, ATTENDX_APP_URL is preferred.
ATTENDX_APP_URL=""
# Existing public URL setting (also accepted as a fallback).
NEXT_PUBLIC_APP_URL=""

# Web3Forms access key for the server-side Contact Us endpoint.
WEB3FORMS_ACCESS_KEY=""

# SMTP for verification and account-security emails (use Gmail App Password,
# not your regular password, if using Gmail)
# Get an App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FROM="AttendX <your-email@gmail.com>"

# Optional: Upstash Redis for production-grade rate limiting
# Leave blank to use PostgreSQL fallback (already configured)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
