# Copy this file to .env for local development.
# NEVER put real secrets in this file. Real values live only in your local
# .env (gitignored) and in Netlify's environment variables.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Session / signing secret ─────────────────────────────────────────
# Generate with: openssl rand -hex 32   (must be the same in every env)
ATTENDX_SECRET="replace-with-a-long-random-string"

# ── Google OAuth (student sign-in) ───────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID → type "Web application"
# 3. Add the Authorized redirect URIs:
#      Local:    http://localhost:3000/api/auth/google/callback
#      Netlify:  https://<your-site>.netlify.app/api/auth/google/callback
#    (The callback route is always <APP_URL>/api/auth/google/callback)
# 4. Copy the client ID and secret here (local .env) and into Netlify
#    Site settings → Environment variables.
# DO NOT commit real values to GitHub.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Application URL ──────────────────────────────────────────────────
# Base URL used to build OAuth redirects. Netlify sets `URL` automatically
# during builds; NEXT_PUBLIC_APP_URL is a fallback for local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
