# Copy this file to .env for local development, and set the same variables in
# Netlify: Site settings → Environment variables (do NOT commit your real .env file).

# Postgres connection string. Free options:
#   - Netlify DB: Site → Extensions → Database (one click, gives you this automatically)
#   - Neon: https://neon.tech (free tier, works great with Prisma)
#   - Supabase: https://supabase.com (free tier)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign session/login cookies. Must be a long random string, and MUST be
# set in production — the app will refuse to start in production without it.
# Generate one with:  openssl rand -hex 32
ATTENDX_SECRET="replace-with-a-long-random-string"
