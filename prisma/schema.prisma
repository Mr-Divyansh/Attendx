// AttendX — Prisma schema
// Mirrors the spec's 10-table MySQL design across 3 logical zones:
//   Zone 1 — Identity & Auth (college): User, Admin, Teacher, Student
//   Zone 2 — Academic Structure: Subject, Timetable, Attendance (+ Department, Semester, Section)
//   Zone 3 — Personal Mode (isolated): PersonalUser, PersonalTimetable, PersonalAttendance, Notification, Setting
// All passwords bcrypt-hashed. Audit columns on attendance (markedBy/markedAt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// ZONE 1 — Identity & Auth (College)
// ───────────────────────────────────────────────────────────

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  admin        Admin?
  teacher      Teacher?
  student      Student?
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  perms     String   @default("all") // JSON-ish permission string
  createdAt DateTime @default(now())
}

model Teacher {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  deptId    String?
  department Department? @relation(fields: [deptId], references: [id])
  createdAt DateTime   @default(now())

  subjects  Subject[]
  slots     Timetable[]
  marked    Attendance[] @relation("MarkedBy")
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  rollNo      String
  semesterId  String?
  sectionId   String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  section     Section?  @relation(fields: [sectionId], references: [id])
  createdAt   DateTime  @default(now())

  attendance Attendance[]
}

// ───────────────────────────────────────────────────────────
// ZONE 2 — Academic Structure
// ───────────────────────────────────────────────────────────

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())

  teachers Teacher[]
  subjects Subject[]
}

model Semester {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "Semester 1"
  number    Int       @unique
  createdAt DateTime  @default(now())

  students Student[]
  subjects Subject[]
  sections Section[]
}

model Section {
  id          String    @id @default(cuid())
  name        String    @unique // e.g. "Section A"
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  createdAt   DateTime   @default(now())

  students  Student[]
  timetables Timetable[]
  subjects   Subject[]
}

model Subject {
  id          String     @id @default(cuid())
  code        String     @unique // e.g. "CS101"
  name        String     // e.g. "Programming in C"
  semesterId  String?
  sectionId   String?
  deptId      String?
  teacherId   String?
  semester    Semester?  @relation(fields: [semesterId], references: [id])
  section     Section?   @relation(fields: [sectionId], references: [id])
  department  Department? @relation(fields: [deptId], references: [id])
  teacher     Teacher?   @relation(fields: [teacherId], references: [id])
  createdAt   DateTime   @default(now())

  timetables  Timetable[]
  attendance  Attendance[]
}

model Timetable {
  id         String   @id @default(cuid())
  sectionId  String?
  subjectId  String?
  teacherId  String?
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id])
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  day        String   // Mon..Sun
  period     Int      // 1..N
  startTime  String   // HH:mm
  endTime    String   // HH:mm
  room       String?
  createdAt  DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String?
  subjectId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id])
  date       String   // YYYY-MM-DD
  period     Int
  status     String   // present | absent | late
  markedById String?
  markedBy   Teacher? @relation("MarkedBy", fields: [markedById], references: [id])
  markedAt   DateTime @default(now())

  @@unique([studentId, subjectId, date, period])
}

// ───────────────────────────────────────────────────────────
// ZONE 3 — Personal Mode (isolated data plane)
// ───────────────────────────────────────────────────────────

model PersonalUser {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  timetable    PersonalTimetable[]
  attendance   PersonalAttendance[]
  notifications Notification[]
  settings     Setting?
}

model PersonalTimetable {
  id          String       @id @default(cuid())
  userId      String
  user        PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String       // Mon..Sun
  period      Int
  startTime   String
  endTime     String
  subjectName String
  room        String?
  teacher     String?
  createdAt   DateTime     @default(now())

  @@unique([userId, day, period])
}

model PersonalAttendance {
  id          String       @id @default(cuid())
  userId      String
  user        PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String       // YYYY-MM-DD
  period      Int
  status      String       // present | absent
  subjectName String
  createdAt   DateTime     @default(now())

  @@unique([userId, date, period])
}

model Notification {
  id        String       @id @default(cuid())
  userId    String?
  user      PersonalUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String       // info | warning | below_target | unmarked
  message   String
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model Setting {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  darkMode  Boolean      @default(false)
  language  String       @default("en")
  goalPct   Int          @default(75)
  avatarUrl String?
}
