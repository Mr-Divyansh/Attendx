// AttendX — Prisma schema
// Mirrors the spec's 10-table MySQL design across 3 logical zones:
//   Zone 1 — Identity & Auth (college): User, Admin, Teacher, Student
//   Zone 2 — Academic Structure: Subject, Timetable, Attendance (+ Department, Semester, Section)
//   Zone 3 — Personal Mode (isolated): PersonalUser, PersonalTimetable, PersonalAttendance, Notification, Setting
// All passwords bcrypt-hashed. Audit columns on attendance (markedBy/markedAt).

generator client {
  provider = "prisma-client-js"
}

// IMPORTANT: this used to be "sqlite". SQLite writes to a local file on disk, and
// Netlify's serverless functions get a fresh, throwaway filesystem on (almost) every
// request — so every signup/attendance-mark/etc. would vanish, and sometimes even the
// file itself wouldn't exist yet, causing random 500s. That's very likely the root
// cause of the live site "erroring out". Postgres is a real always-on database, so this
// works correctly on Netlify. Get a free connection string from Neon (neon.tech) or via
// Netlify's own "Netlify DB" add-on (Site → Extensions → Database), then put it in
// DATABASE_URL — see .env.example.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// ZONE 1 — Identity & Auth (College)
// ───────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(STUDENT)
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin                Admin?
  teacher              Teacher?
  student              Student?
  authAccounts         AuthAccount[]
  collegeNotifications CollegeNotification[]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  perms     String   @default("all") // JSON-ish permission string
  createdAt DateTime @default(now())
}

model Teacher {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  subjectTaught   String?
  institutionName String?
  departmentLabel String?
  deptId          String?
  department      Department? @relation(fields: [deptId], references: [id])
  profileComplete Boolean     @default(false)
  createdAt       DateTime    @default(now())

  subjects   Subject[]
  slots      Timetable[]
  marked     Attendance[] @relation("MarkedBy")
  classrooms Classroom[]
  semesters  Semester[]   @relation("TeacherSemesters")
  sections   Section[]    @relation("TeacherSections")
}

model Student {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  rollNo          String
  hasRollNumber   Boolean   @default(true)
  semesterId      String?
  sectionId       String?
  semester        Semester? @relation(fields: [semesterId], references: [id])
  section         Section?  @relation(fields: [sectionId], references: [id])
  studentType     String? // SCHOOL or COLLEGE
  institutionName String?
  gradeLevel      String?
  schoolSection   String?
  academicYear    String?
  course          String?
  semesterLabel   String?
  profileComplete Boolean   @default(false)
  createdAt       DateTime  @default(now())

  attendance           Attendance[]
  classroomMemberships ClassroomMember[]
}

// ───────────────────────────────────────────────────────────
// ZONE 2 — Academic Structure
// ───────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  teachers Teacher[]
  subjects Subject[]
}

model Semester {
  id        String   @id @default(cuid())
  name      String // e.g. "Semester 1"
  number    Int      @default(0)
  teacherId String?
  teacher   Teacher? @relation("TeacherSemesters", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  students Student[]
  subjects Subject[]
  sections Section[]
}

model Section {
  id         String    @id @default(cuid())
  name       String // e.g. "Section A"
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])
  teacherId  String?
  teacher    Teacher?  @relation("TeacherSections", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  students   Student[]
  timetables Timetable[]
  subjects   Subject[]
}

model Subject {
  id         String      @id @default(cuid())
  code       String      @unique // e.g. "CS101"
  name       String // e.g. "Programming in C"
  semesterId String?
  sectionId  String?
  deptId     String?
  teacherId  String?
  semester   Semester?   @relation(fields: [semesterId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])
  department Department? @relation(fields: [deptId], references: [id])
  teacher    Teacher?    @relation(fields: [teacherId], references: [id])
  createdAt  DateTime    @default(now())

  timetables Timetable[]
  attendance Attendance[]
  classrooms Classroom[]
}

model Classroom {
  id           String            @id @default(cuid())
  publicId     String            @unique
  teacherId    String
  teacher      Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?          @relation(fields: [subjectId], references: [id])
  name         String
  course       String?
  section      String?
  semesterId   String?
  sectionId    String?
  teachingMode String?           @default("COLLEGE")
  room         String?
  academicYear String?
  year         Int? // academic year of study: 1–4 (Year 1, Year 2, …)
  durationYears Int? // intended validity of the classroom: 1–4 years
  expiresAt    DateTime? // computed end of class validity (createdAt + durationYears)
  joinCode     String            @unique
  inviteToken  String            @unique
  createdAt    DateTime          @default(now())
  members      ClassroomMember[]
  attendance   Attendance[]
  schedules    Timetable[]
}

model ClassroomMember {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String    @default("ACTIVE")
  joinedAt    DateTime  @default(now())

  @@unique([classroomId, studentId])
}

model Timetable {
  id          String     @id @default(cuid())
  sectionId   String?
  subjectId   String?
  teacherId   String?
  section     Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  teacher     Teacher?   @relation(fields: [teacherId], references: [id])
  day         String // Mon..Sun
  period      Int        @default(0) // legacy ordering only; teacher workflow uses time
  startTime   String // HH:mm
  endTime     String // HH:mm
  room        String?
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model Attendance {
  id          String     @id @default(cuid())
  studentId   String?
  subjectId   String?
  classroomId String?
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  period      Int        @default(0) // retained for legacy/admin records
  startTime   String?
  endTime     String?
  status      String // present | absent | late
  markedById  String?
  markedBy    Teacher?   @relation("MarkedBy", fields: [markedById], references: [id])
  markedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([studentId, subjectId, date, period])
  @@unique([studentId, classroomId, date, period])
}

// ───────────────────────────────────────────────────────────
// ZONE 3 — Personal Mode (isolated data plane)
// ───────────────────────────────────────────────────────────

model PersonalUser {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  timetable     PersonalTimetable[]
  attendance    PersonalAttendance[]
  notifications Notification[]
  settings      Setting?
}

model PersonalTimetable {
  id          String       @id @default(cuid())
  userId      String
  user        PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String // Mon..Sun
  period      Int
  startTime   String
  endTime     String
  subjectName String
  room        String?
  teacher     String?
  createdAt   DateTime     @default(now())

  @@unique([userId, day, period])
}

model PersonalAttendance {
  id          String       @id @default(cuid())
  userId      String
  user        PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  period      Int
  status      String // present | absent
  subjectName String
  createdAt   DateTime     @default(now())

  @@unique([userId, date, period])
}

model Notification {
  id        String        @id @default(cuid())
  userId    String?
  user      PersonalUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // info | warning | below_target | unmarked
  message   String
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model Setting {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      PersonalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  darkMode  Boolean      @default(false)
  language  String       @default("en")
  goalPct   Int          @default(75)
  avatarUrl String?
}

// ───────────────────────────────────────────────────────────
// System-wide settings & college notifications
// ───────────────────────────────────────────────────────────

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model CollegeNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // info | warning | low_attendance | advice
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
